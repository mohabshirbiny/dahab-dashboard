# Copy to `.env.local` (or set in the deploy environment) and adjust.
#
# Dahab Backend API root, including the version prefix, without a trailing slash.
# The Backend must list this app's origin in its CORS_ALLOWED_ORIGINS.
# Leave unset to call `/api/v1` on the same origin as the dashboard.
VITE_API_BASE_URL=https://api.example.com/api/v1
